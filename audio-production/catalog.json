{
  "schemaVersion": 1,
  "about": "Ljudkatalog för Outbreak (adult) och Mini Outbreak (mini). Källa för audio-production/generate.ts, docs/AUDIO-*.md och tester. Text i 'text' skickas oförändrad till ElevenLabs (engelska). Ändra inte id:n för ljud som redan har godkänts: id:t är nyckeln i manifest.json.",
  "products": {
    "adult": { "publicDir": "public/audio/el", "urlPrefix": "/audio/el" },
    "mini": { "publicDir": "apps/mini/public/audio/el", "urlPrefix": "/audio/el" }
  },
  "priorities": {
    "P0": "Kritisk säkerhets- eller spelinformation (fiende i kontakt, avstånd). Avbryter allt utom annan P0.",
    "P1": "Matchens utfall och extraction, GPS-förlust. Avbryter P2–P4.",
    "P2": "Fiendevarningar. Avbryter P3–P4.",
    "P3": "Checkpoints och bekräftelser. Avbryter P4.",
    "P4": "Atmosfär och fiendeläten. Avbryter aldrig något; tappas hellre än köas."
  },
  "pricing": {
    "verifiedAt": "2026-10-29",
    "sources": [
      "https://elevenlabs.io/pricing/api",
      "https://elevenlabs.io/docs/overview/capabilities/sound-effects",
      "https://elevenlabs.io/docs/overview/models"
    ],
    "tts": {
      "eleven_multilingual_v2": { "usdPer1kChars": 0.08, "creditsPerChar": 1, "creditsCertain": false },
      "eleven_v3": { "usdPer1kChars": 0.08, "creditsPerChar": 1, "creditsCertain": false },
      "eleven_flash_v2_5": { "usdPer1kChars": 0.04, "creditsPerChar": 0.5, "creditsCertain": false },
      "eleven_flash_v2": { "usdPer1kChars": 0.04, "creditsPerChar": 0.5, "creditsCertain": false }
    },
    "sfx": {
      "eleven_text_to_sound_v2": { "creditsPerSecond": 40, "creditsCertain": true, "usdPerMinute": 0.12, "usdCertain": false }
    },
    "notes": "USD-priserna gäller API-fakturering i dollar (pay-as-you-go). Krediter gäller abonnemang. Tecken→krediter för TTS står inte i nuvarande dokumentation och är ett antagande (1 per tecken, 0,5 för Flash). Ljudeffekter: '40 credits per second when duration is specified' är dokumenterat; dollarpriset är motsägelsefullt på prissidan (per minut vs per generering). Varje ljudeffekt i katalogen har därför en angiven längd."
  },
  "defaults": {
    "outputFormat": "mp3_44100_128",
    "ttsModel": "eleven_multilingual_v2",
    "sfxModel": "eleven_text_to_sound_v2",
    "sfxPromptInfluence": 0.5
  },
